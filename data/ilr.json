     "id": "ilr-01.g.time",
     "title": "Telling the time",
     "rule": "Este ora + the hour, with feminine numbers: ora două, ora douăsprezece (but ora unu). Minutes after the hour: și (ora opt și zece). Half past: și jumătate. Quarter: un sfert. Minutes before the next hour: fără (ora șapte fără zece = 6:50). From 20 on, numbers take de: douăzeci de minute.",
     "examples": [
      { "ro": "Este ora nouă și jumătate.", "en": "It is half past nine." },
      { "ro": "Este ora șapte fără un sfert.", "en": "It is quarter to seven." }
     ],
     "items": [
      { "id": "ilr-01.g.time.1", "kind": "type", "instruction": "Write the time in words, starting with ora.", "prompt": "9:00", "answer": ["ora nouă", "nouă"] },
