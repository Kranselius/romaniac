   "verbs": ["a-fi", "a-avea", "a-vrea", "a-putea", "a-merge", "a-manca", "a-bea", "a-sti", "a-dormi", "a-cumpara", "a-pleca", "a-locui"],
   "grammar": [
    {
     "id": "ilr-01.g.pron",
     "title": "Personal pronouns",
     "rule": "eu (I), tu (you), el / ea (he / she), noi (we), voi (you, plural), ei / ele (they: masculine or mixed / only feminine). Dumneavoastră is the polite “you” and takes the voi form of the verb: Dumneavoastră aveți…",
     "examples": [
      { "ro": "Ei sunt frați, ele sunt surori.", "en": "They are brothers, they (the women) are sisters." },
      { "ro": "Dumneavoastră aveți o casă frumoasă.", "en": "You (polite) have a beautiful house." }
     ],
     "items": [
      { "id": "ilr-01.g.pron.1", "promptLang": "en", "kind": "type", "instruction": "Write the pronoun in Romanian.", "prompt": "we", "answer": ["noi"] },
      { "id": "ilr-01.g.pron.2", "promptLang": "en", "kind": "type", "instruction": "Write the pronoun in Romanian.", "prompt": "she", "answer": ["ea"] },
      { "id": "ilr-01.g.pron.3", "promptLang": "en", "kind": "type", "instruction": "Write the pronoun in Romanian.", "prompt": "they (a man and a woman)", "answer": ["ei"] },
      { "id": "ilr-01.g.pron.4", "promptLang": "en", "kind": "choice", "instruction": "Pick the pronoun.", "prompt": "they (only women)", "options": ["ele", "ei", "voi"], "answer": ["ele"] },
      { "id": "ilr-01.g.pron.5", "promptLang": "en", "kind": "choice", "instruction": "Pick the pronoun.", "prompt": "you (polite)", "options": ["dumneavoastră", "tu", "voi"], "answer": ["dumneavoastră"] },
      { "id": "ilr-01.g.pron.6", "kind": "choice", "instruction": "Pick the right verb form.", "prompt": "Dumneavoastră ___ două surori.", "options": ["aveți", "ai", "are"], "answer": ["aveți"] }
     ]
    },
    {
     "id": "ilr-01.g.aux",
     "title": "a fi and a avea (present)",
     "rule": "a fi: sunt, ești, este (e), suntem, sunteți, sunt. a avea: am, ai, are, avem, aveți, au. Age uses a avea: Am treizeci de ani (I am thirty).",
     "examples": [
      { "ro": "Noi suntem din Suedia.", "en": "We are from Sweden." },
      { "ro": "Ea are o pisică.", "en": "She has a cat." }
     ],
     "items": [
      { "id": "ilr-01.g.aux.1", "kind": "type", "instruction": "Fill in the right form.", "prompt": "Noi ___ din Suedia. (a fi)", "answer": ["suntem"] },
      { "id": "ilr-01.g.aux.2", "kind": "type", "instruction": "Fill in the right form.", "prompt": "Tu ___ acasă? (a fi)", "answer": ["ești"] },
      { "id": "ilr-01.g.aux.3", "kind": "type", "instruction": "Fill in the right form.", "prompt": "Voi ___ prieteni. (a fi)", "answer": ["sunteți"] },
      { "id": "ilr-01.g.aux.4", "kind": "type", "instruction": "Fill in the right form.", "prompt": "Eu ___ o pisică. (a avea)", "answer": ["am"] },
      { "id": "ilr-01.g.aux.5", "kind": "type", "instruction": "Fill in the right form.", "prompt": "Ei ___ doi copii. (a avea)", "answer": ["au"] },
      { "id": "ilr-01.g.aux.6", "kind": "type", "instruction": "Fill in the right form.", "prompt": "Ea ___ o mașină roșie. (a avea)", "answer": ["are"] },
      { "id": "ilr-01.g.aux.7", "kind": "choice", "instruction": "Pick the right verb.", "prompt": "Câți ani ___?", "options": ["ai", "ești", "are"], "answer": ["ai"] }
     ]
    },
    {
     "id": "ilr-01.g.neg",
     "title": "Saying no: nu",
     "rule": "Put nu right before the verb: Beau cafea → Nu beau cafea. With îmi place: Nu îmi place (often shortened to Nu-mi place).",
     "examples": [
      { "ro": "Nu avem mașină.", "en": "We don't have a car." },
      { "ro": "Nu-mi place varza.", "en": "I don't like cabbage." }
     ],
     "items": [
      { "id": "ilr-01.g.neg.1", "kind": "type", "instruction": "Make it negative.", "prompt": "Eu beau cafea.", "answer": ["Eu nu beau cafea.", "Nu beau cafea."] },
      { "id": "ilr-01.g.neg.2", "kind": "type", "instruction": "Make it negative.", "prompt": "Ea vrea supă.", "answer": ["Ea nu vrea supă."] },
      { "id": "ilr-01.g.neg.3", "kind": "type", "instruction": "Make it negative.", "prompt": "Noi mergem la școală.", "answer": ["Noi nu mergem la școală.", "Nu mergem la școală."] },
      { "id": "ilr-01.g.neg.4", "kind": "type", "instruction": "Make it negative.", "prompt": "Îmi place varza.", "answer": ["Nu îmi place varza.", "Nu-mi place varza."] },
      { "id": "ilr-01.g.neg.5", "kind": "order", "instruction": "Build the sentence.", "prompt": "We don't have a car.", "answer": ["Noi nu avem mașină.", "Nu avem mașină."] }
     ]
    },
    {
     "id": "ilr-01.g.sa",
     "title": "vreau / pot / trebuie + să",
     "rule": "After vreau (I want), trebuie (must, have to) and pot (can), the next verb usually takes să + the subjunctive: Vreau să mănânc. Trebuie să plec. Pot also works with the plain infinitive: Pot mânca = Pot să mănânc. Trebuie stays the same for every person: trebuie să beau, trebuie să bei.",
     "examples": [
      { "ro": "Vreau să merg la restaurant.", "en": "I want to go to the restaurant." },
      { "ro": "El trebuie să bea apă.", "en": "He has to drink water." }
     ],
     "items": [
      { "id": "ilr-01.g.sa.1", "kind": "type", "instruction": "Fill in the verb after să.", "prompt": "Vreau să ___ ciocolată. (a mânca)", "answer": ["mănânc"] },
      { "id": "ilr-01.g.sa.2", "kind": "type", "instruction": "Fill in the verb after să.", "prompt": "Tu vrei să ___ la restaurant? (a merge)", "answer": ["mergi"] },
      { "id": "ilr-01.g.sa.3", "kind": "type", "instruction": "Fill in the verb after să.", "prompt": "El trebuie să ___ apă. (a bea)", "answer": ["bea"] },
      { "id": "ilr-01.g.sa.4", "kind": "type", "instruction": "Fill in the verb after să.", "prompt": "Noi vrem să ___ legume. (a cumpăra)", "answer": ["cumpărăm"] },
      { "id": "ilr-01.g.sa.5", "kind": "type", "instruction": "Fill in the verb after să.", "prompt": "Ei vor să ___ acum. (a dormi)", "answer": ["doarmă"] },
      { "id": "ilr-01.g.sa.6", "kind": "choice", "instruction": "Pick the right form.", "prompt": "Voi ___ să plecați.", "options": ["trebuie", "trebuiți", "trebuim"], "answer": ["trebuie"] },
      { "id": "ilr-01.g.sa.7", "kind": "order", "instruction": "Build the sentence.", "prompt": "I can eat chocolate now.", "answer": ["Pot să mănânc ciocolată acum.", "Pot mânca ciocolată acum."] }
     ]
    },
